[Unit]
Description=lanbox 文件与消息共享服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 建议专用低权限用户；数据目录与二进制需对该用户可读可执行
User=lanbox
Group=lanbox
# 443 是特权端口（<1024），给二进制单独授予绑定能力，无需 root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/opt/lanbox
ExecStart=/opt/lanbox/lanbox -config /etc/lanbox/config.json
Restart=always
RestartSec=3
# 首次启动会打印随机 admin 密码到 journal，用 journalctl -u lanbox -n 30 查看
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lanbox

[Install]
WantedBy=multi-user.target
